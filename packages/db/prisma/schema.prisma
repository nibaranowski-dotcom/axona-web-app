// Axona data model (build-spec §3).
//   §3.1 Core/tenancy (FND.5) · §3.2 Agents/Chats/Workflows/Runs (FND.6)
//   §3.3 Projects/Files/MatrixColumn + pgvector (FND.7) · §3.4 Machines (FND.8)
//   §3.5 Value-chain (FND.9) · §3.6 Robotics + back office (FND.10)
//
// FND.11: formal `org Org @relation(... onDelete: Cascade)` on every tenant-owned
// model + Org back-relations + the cross-entity FKs (R3). Children that inherit
// tenancy via a parent FK (Message/AgentRun/WorkflowRun/File/MatrixColumn/
// MachineSignal) carry NO orgId. Module is a global catalog. Org-scoped client +
// per-tenant isolation (ISO.1) live in packages/db/src/client.ts.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─── Core / tenancy (§3.1) ─────────────────────────────────────────────────

/// The tenant root. Every tenant-owned model hangs off an Org via `orgId`;
/// onDelete: Cascade means deleting an Org offboards all its data (destructive).
model Org {
  id                   String    @id @default(cuid())
  name                 String
  /// AUTH.4: the workspace URL slug (e.g. "axona-demo-co"), derived from name;
  /// uniqueness enforced (auto-suffixed on collision at provisioning time).
  slug                 String?   @unique
  /// AUTH.4: the org's vertical (Humanoid / Mobility & AVs / … / Other). Nullable.
  industry             String?
  /// AUTH.6: null until the onboarding wizard is finished (the AUTH.3 routing flag).
  onboardedAt          DateTime?
  /// AUTH.6: the enabled module `key`s. Null/EMPTY ⇒ treat as ALL (back-compat for
  /// the demo + any pre-existing org). The wizard writes the chosen subset. SET.1
  /// reuses this for later editing.
  enabledModules       String[]
  /// SET.1: org branding/config. logoKey → a FILE.1 blob key (upload UI deferred);
  /// timezone (IANA), fiscalYearStartMonth (1–12), defaultMemberRole prefills new
  /// invites (ties to SET.2/AUTH.5). All nullable.
  logoKey              String?
  timezone             String?
  fiscalYearStartMonth Int?
  defaultMemberRole    Role?
  createdAt            DateTime  @default(now())

  // back-relations — one array per tenant-owned model (FND.11)
  users            User[]
  agents           Agent[]
  chats            Chat[]
  workflows        Workflow[]
  projects         Project[]
  machines         Machine[]
  suppliers        Supplier[]
  parts            Part[]
  purchaseOrders   PurchaseOrder[]
  workOrdersMfg    WorkOrderMfg[]
  ncrs             NCR[]
  spcSamples       SpcSample[]
  certs            Cert[]
  deals            Deal[]
  campaigns        Campaign[]
  deliveries       Delivery[]
  robots           Robot[]
  telemetry        TelemetryPoint[]
  workOrdersField  WorkOrderField[]
  technicians      Technician[]
  ecos             ECO[]
  firmwareReleases FirmwareRelease[]
  compatCells      CompatCell[]
  autonomyMetrics  AutonomyMetric[]
  safetyIncidents  SafetyIncident[]
  policyVersions   PolicyVersion[]
  ledgerEntries    LedgerEntry[]
  invoices         Invoice[]
  unitEconomics    UnitEconomic[]
  requisitions     Requisition[]
  cves             CVE[]
  obligations      Obligation[]
  exportLicenses   ExportLicense[]
  legalMatters     LegalMatter[]
  searchDocs       SearchDoc[]
}

model User {
  id            String    @id @default(cuid())
  orgId         String
  org           Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  email         String    @unique
  role          Role
  /// AUTH.1: bcrypt hash of the password (Credentials provider). Nullable —
  /// SSO-only users (AUTH.2) won't have one. NEVER returned to the client / logged.
  passwordHash  String?
  /// SET.2: set = deactivated (can't log in, not an active seat). Null = active.
  deactivatedAt DateTime?
  /// SET.2: updated on successful login → powers the members "last active" column.
  lastSeenAt    DateTime?
  /// SET.3: avatar blob key (FILE.1 storage; upload UI deferred). Nullable.
  avatarKey     String?
  /// SET.3: bumped by "sign out everywhere" / password change. The JWT carries it;
  /// getCurrentUser rejects a token whose version ≠ this (stateless-JWT revoke).
  tokenVersion  Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([orgId])
}

/// SET.3 — a signed-in device/session for the profile "Sessions & devices" list.
/// Created on each successful login. Per-session remote revoke is best-effort under
/// stateless JWT; the reliable control is "sign out everywhere" (User.tokenVersion).
model LoginSession {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  device     String
  ip         String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([orgId])
  @@index([userId])
}

enum Role {
  ADMIN
  OPS
  ENGINEER
  SALES
  FINANCE
  TECH
  VIEWER
}

// AUTH.5 — a token invite to JOIN an existing org at a role. Public accept via
// /invite/:token. Tokens are crypto-random, single-use (PENDING→ACCEPTED), and
// expiring (7d). The invitee joins at exactly `role` — never escalated. One invite
// binds one orgId (no cross-org). Email delivery is EMAIL.1 (link copied for now).
enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invite {
  id             String       @id @default(cuid())
  orgId          String
  email          String // invited address (lowercased)
  role           Role // the role they'll join at
  token          String       @unique // crypto-random, unguessable (32-byte base64url)
  status         InviteStatus @default(PENDING)
  invitedById    String // the user who created it
  invitedByLabel String // denormalized for the accept screen ("M. Osei")
  createdAt      DateTime     @default(now())
  expiresAt      DateTime // now + 7 days
  acceptedAt     DateTime?

  @@index([orgId])
  @@index([token])
  @@index([email])
}

/// Global system catalog of product modules (not tenant-owned — no orgId).
/// Enablement per tenant lands later (org settings / SET.1).
model Module {
  id         String      @id
  key        String      @unique
  name       String
  group      ModuleGroup
  orderIndex Int
}

enum ModuleGroup {
  CORE
  VALUE_CHAIN
  ROBOTICS
  BACK_OFFICE
}

// ─── Agents / chats / workflows / runs (§3.2) ──────────────────────────────
// Tenancy: Agent/Chat/Workflow are tenant-owned -> orgId + @@index([orgId]).
// AgentRun/Message/WorkflowRun inherit tenancy through their parent FK (indexed).

model Agent {
  id          String     @id @default(cuid())
  orgId       String
  org         Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  moduleKey   String // owning module, or "core"
  name        String // "Sourcing agent"
  code        String // "proc-04"
  role        String // "SOURCING"
  description String // one-liner: what it does
  state       AgentState @default(LIVE)
  runs        AgentRun[]

  draftedPurchaseOrders PurchaseOrder[] // POs this agent drafted (PurchaseOrder.draftedByAgentId)

  @@index([orgId])
}

enum AgentState {
  LIVE
  WORKING
  CRITICAL
  OFFLINE
}

model Chat {
  id        String    @id @default(cuid())
  orgId     String
  org       Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentId   String?
  userId    String
  scope     String
  createdAt DateTime  @default(now())
  messages  Message[]

  @@index([orgId])
  @@index([agentId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])
  role      MsgRole
  text      String
  citations Json?
  createdAt DateTime @default(now())

  @@index([chatId])
}

enum MsgRole {
  USER
  AGENT
  SYSTEM
}

model Workflow {
  id          String         @id @default(cuid())
  orgId       String
  org         Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  moduleKey   String
  name        String
  description String
  status      WorkflowStatus @default(DRAFT)
  trigger     Json // event spec
  steps       Json // ordered nodes: agent steps, decision gates, output
  runs        WorkflowRun[]

  @@index([orgId])
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

model WorkflowRun {
  id         String    @id @default(cuid())
  workflowId String
  workflow   Workflow  @relation(fields: [workflowId], references: [id])
  /// WF.1 tenancy: scalar orgId (+ @@index) so run reads org-scope without a
  /// join, matching the scalar-orgId tenancy pattern everywhere; the engine sets
  /// it on create. (Previously scoped only via workflowId → Workflow.orgId.)
  orgId      String
  status     RunStatus
  /// Freeform run trace (scan/correlate/draft/policy-check/result). The
  /// immutable event log + calibrated `confidence` + `approver` columns land in
  /// ONT.1 / CONF.1 / AUDIT.3 — do not add those columns here yet.
  /// AUDIT.3: the immutable inputs·output·model·confidence·approver record.
  /// RBAC.4: a run parked at a guardrail gate (AWAITING_APPROVAL) is resumed by
  /// the human-approval state machine — never by the autonomous engine.
  trace      Json
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  @@index([workflowId])
  @@index([orgId])
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  /// WF.1: parked at a guardrail/approval gate — resumed by RBAC.4, never the engine.
  AWAITING_APPROVAL
}

model AgentRun {
  id        String    @id @default(cuid())
  agentId   String
  agent     Agent     @relation(fields: [agentId], references: [id])
  input     Json
  /// Freeform run trace (scan/correlate/draft/policy-check/result). The
  /// immutable event log + calibrated `confidence` + `approver` columns land in
  /// ONT.1 / CONF.1 / AUDIT.3 — do not add those columns here yet.
  trace     Json
  status    RunStatus
  createdAt DateTime  @default(now())

  @@index([agentId])
}

// ─── Projects & files — Hebbia-style matrix (§3.3) ─────────────────────────
// Tenancy: Project is tenant-owned -> orgId + @@index([orgId]).
// File/MatrixColumn inherit tenancy through an indexed projectId FK.

model Project {
  id          String        @id @default(cuid())
  orgId       String
  org         Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  moduleKey   String
  name        String
  description String
  status      ProjectStatus
  members     Json
  files       File[]
  updatedAt   DateTime      @updatedAt

  @@index([orgId])
}

enum ProjectStatus {
  ACTIVE
  IN_REVIEW
  BLOCKED
  DONE
}

model File {
  id        String                 @id @default(cuid())
  projectId String
  project   Project                @relation(fields: [projectId], references: [id])
  name      String
  ext       String
  sizeBytes Int
  blobKey   String
  type      String // Change, Spec, Quote, Report, Data, Memo, Plan…
  linkedTo  String? // e.g. "Engineering · SERVO-205"
  /// FILE.2: the extracted plain text (bounded/truncated) — search body + MTX.1's
  /// per-file Q&A. Distinct from `extracted` (reserved for MTX.1 column answers).
  /// /// MTX.1 reads this for column extraction; /// MEM.1 consumes text+embedding
  /// as the operational-memory capture — extend there; no memory/graph columns here.
  text      String?
  /// AI-extracted column values keyed by columnId (the file-matrix substrate,
  /// MTX.1). This + `embedding` feed operational memory (MEM.1) later — extend
  /// there; do NOT add memory/graph columns here.
  extracted Json
  /// pgvector column. Prisma can't introspect Unsupported types, so the real
  /// vector(1536) column + HNSW ANN index are created via raw SQL in the FND.11
  /// `enable_pgvector_ann` migration (dimension recorded in docs/manual-checks).
  embedding Unsupported("vector")?

  modifiedAt DateTime @updatedAt

  @@index([projectId])
}

// Answers live in File.extracted[columnId].
// projectId is a scalar FK + index (no formal relation — §3.3 has no
// Project.matrixColumns array). Left scalar intentionally (genealogy/graph FKs
// are out of FND.11 scope; revisit only when a story needs the relation).
model MatrixColumn {
  id        String   @id @default(cuid())
  projectId String
  question  String
  createdBy String
  createdAt DateTime @default(now())

  @@index([projectId])
}

// ─── Machines — own plant + mobile units (§3.4) ────────────────────────────
// Tenancy: Machine is tenant-owned -> orgId + @@index([orgId]).
// MachineSignal inherits tenancy through an indexed machineId FK.

model Machine {
  id              String          @id @default(cuid())
  orgId           String
  org             Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assetId         String // "CNC-02"
  name            String
  kind            MachineKind // FIXED | MOBILE
  category        String // CNC, SMT, test-rig, AMR, forklift, demo-unit…
  location        String
  status          MachineStatus
  utilization     Int // 0-100
  health          String // "Healthy", "Re-cal overdue"…
  healthLevel     HealthLevel
  telemetryOnline Boolean
  signals         MachineSignal[]

  @@index([orgId])
}

enum MachineKind {
  FIXED
  MOBILE
}

enum MachineStatus {
  RUNNING
  IDLE
  MAINTENANCE
  CHARGING
  FAULT
}

enum HealthLevel {
  OK
  WATCH
  BAD
}

/// Plant-telemetry time-series. First-class typed telemetry input (TEL.1) that
/// feeds operational memory (MEM.1). The prototype models it as a regular table;
/// the Timescale/hypertable + immutable event-log wiring is TEL.1 — not here yet.
/// The composite @@index([machineId, ts]) keeps time-windowed reads efficient.
model MachineSignal {
  id        String   @id @default(cuid())
  machineId String
  machine   Machine  @relation(fields: [machineId], references: [id])
  ts        DateTime
  metric    String
  value     Float

  @@index([machineId, ts])
}

// ─── Value-chain entities (§3.5) ───────────────────────────────────────────
// All tenant-owned -> orgId + @@index([orgId]) + formal org relation (FND.11).

model Supplier {
  id        String @id @default(cuid())
  orgId     String
  org       Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  tier      Int
  riskScore Float
  onTimePct Float

  purchaseOrders PurchaseOrder[]

  @@index([orgId])
}

model Part {
  id           String @id @default(cuid())
  orgId        String
  org          Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sku          String
  name         String
  onHand       Int
  reorderPoint Int
  leadDays     Int
  /// INV.1 days-of-cover STAND-IN: a seeded daily-consumption constant (units/day)
  /// so cover = onHand ÷ dailyUse is real, not fabricated. The true rate comes from
  /// the build-schedule/BOM-explosion feed (deferred — see docs deferred-ledger).
  dailyUse     Int    @default(1)

  purchaseOrders PurchaseOrder[]

  @@index([orgId])
}

/// INV.1 — multi-echelon stock: real per-location on-hand/reserved/value that the
/// Part.onHand total can't express (central · line-side · edge caches · finished
/// goods). Scalar orgId tenancy (+ FK indexes, no formal relations — FND.11).
/// Read-only in INV; replenishment/transfer/RMA actions are agent-drafted,
/// gated by RBAC.4 with an AUDIT.3 record — no event-log columns here.
model InventoryStock {
  id       String        @id @default(cuid())
  orgId    String
  partId   String
  location String // "Central warehouse" | "Line-side" | "Rotterdam" | "Osaka" | "Detroit" | "Finished goods"
  kind     InventoryKind
  onHand   Int
  reserved Int           @default(0)
  minLevel Int           @default(0) // edge-cache "below min" threshold
  valueUsd Int           @default(0) // stock valuation, whole USD

  @@index([orgId])
  @@index([partId])
}

enum InventoryKind {
  CENTRAL
  LINE_SIDE
  EDGE_CACHE
  FINISHED_GOODS
  PLANT
}

model PurchaseOrder {
  id               String    @id @default(cuid())
  orgId            String
  org              Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  code             String
  supplierId       String
  supplier         Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  partId           String
  part             Part      @relation(fields: [partId], references: [id], onDelete: Restrict)
  qty              Int
  value            Float
  /// Agent-drafted PO surface — the propose→approve→audit moat. The approval
  /// state machine (DRAFTED→AWAITING_APPROVAL→APPROVED→SENT) lives in RBAC.4;
  /// the immutable who/model/confidence/approver record lands in AUDIT.3.
  status           POStatus
  draftedByAgentId String?
  draftedByAgent   Agent?    @relation(fields: [draftedByAgentId], references: [id], onDelete: SetNull)
  eta              DateTime?

  @@index([orgId])
  @@index([supplierId])
  @@index([partId])
  @@index([draftedByAgentId])
}

enum POStatus {
  DRAFTED
  AWAITING_APPROVAL
  APPROVED
  SENT
  RECEIVED
  /// RBAC.4: a human rejected the PO at the approval gate — terminal (no send).
  /// The only non-forward state; added because none of the above means "rejected".
  REJECTED
}

model WorkOrderMfg {
  id        String    @id @default(cuid())
  orgId     String
  org       Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// As-built genealogy anchor — parts·serials·firmware captured AS BUILT, never
  /// reconstructed (capture fidelity caps the moat). The genealogy graph over
  /// this serial lands in ONT.2; keep capture clean here.
  serial    String
  product   String
  station   String
  status    String
  startedAt DateTime?

  @@index([orgId])
}

model NCR {
  id       String   @id @default(cuid())
  orgId    String
  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  code     String
  defect   String
  /// String reference into the genealogy/quality graph (e.g. "lot 88421") — kept
  /// a plain string, not an FK (crosses to ONT.2, out of FND.11 scope).
  linkedTo String
  severity Severity
  status   String

  @@index([orgId])
}

enum Severity {
  MINOR
  MAJOR
  CRITICAL
}

/// SPC quality telemetry (measurement vs UCL/LCL/mean). First-class quality
/// signal feeding operational memory (MEM.1); modeled as a plain table for now.
model SpcSample {
  id             String   @id @default(cuid())
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  characteristic String
  serial         String
  value          Float
  ucl            Float
  lcl            Float
  mean           Float
  ts             DateTime

  @@index([orgId])
  @@index([characteristic, ts])
}

model Cert {
  id      String   @id @default(cuid())
  orgId   String
  org     Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name    String
  scope   String
  validTo DateTime
  status  String

  @@index([orgId])
}

model Deal {
  id          String      @id @default(cuid())
  orgId       String
  org         Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account     String
  config      String
  value       Float
  stage       DealStage
  closeDate   DateTime?
  feasibility Feasibility

  @@index([orgId])
}

enum DealStage {
  QUALIFY
  DEMO
  PROPOSAL
  NEGOTIATION
  COMMIT
}

enum Feasibility {
  ON_TIME
  AT_RISK
  NOT_CHECKED
}

model Campaign {
  id       String @id @default(cuid())
  orgId    String
  org      Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name     String
  channel  String
  mqls     Int
  pipeline Float
  roi      Float
  status   String

  @@index([orgId])
}

model Delivery {
  id            String        @id @default(cuid())
  orgId         String
  org           Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  code          String
  account       String
  destination   String
  units         String
  stage         DeliveryStage
  committedDate DateTime
  etaDate       DateTime
  riskState     String

  @@index([orgId])
  @@index([stage])
}

enum DeliveryStage {
  ALLOC
  CRATE
  FREIGHT
  CUSTOMS
  ONSITE
  COMMISSION
  ACTIVE
}

// ─── Robotics + back office (§3.6) ─────────────────────────────────────────
// All tenant-owned -> orgId + @@index([orgId]) + formal org relation (FND.11).
// REUSES the Severity enum from §3.5 (WorkOrderField/SafetyIncident/CVE).

model Robot {
  id        String @id @default(cuid())
  orgId     String
  org       Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Links a deployed unit back to its as-built genealogy (parts·serials·
  /// firmware) — the ONT.2 genealogy graph keys on this serial (string, not FK).
  serial    String
  model     String
  customer  String
  site      String
  uptimePct Float
  firmware  String
  status    String
  lat       Float?
  lng       Float?

  telemetry TelemetryPoint[]

  @@index([orgId])
}

/// First-class fleet telemetry time-series (TEL.1) feeding operational memory
/// (MEM.1). Plain table for the prototype; Timescale/hypertable + event-log
/// wiring is TEL.1. Composite @@index([robotId, ts]) for time-windowed reads.
model TelemetryPoint {
  id      String   @id @default(cuid())
  orgId   String
  org     Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  robotId String
  robot   Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  ts      DateTime
  metric  String
  value   Float

  @@index([orgId])
  @@index([robotId, ts])
}

model WorkOrderField {
  id          String      @id @default(cuid())
  orgId       String
  org         Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  code        String
  robotSerial String
  site        String
  issue       String
  slaDueAt    DateTime?
  techId      String?
  tech        Technician? @relation(fields: [techId], references: [id], onDelete: SetNull)
  status      String
  severity    Severity

  @@index([orgId])
  @@index([techId])
  @@index([slaDueAt])
}

model Technician {
  id       String @id @default(cuid())
  orgId    String
  org      Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name     String
  initials String
  site     String
  status   String
  certs    Json // cert matrix: {certKey: {state, expiresAt}}

  workOrders WorkOrderField[]

  @@index([orgId])
}

model ECO {
  id         String @id @default(cuid())
  orgId      String
  org        Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  code       String
  title      String
  changeType String
  affected   String
  /// Gated change-control state (DRAFT/REVIEW/APPROVED/RELEASED). The release
  /// approval state machine is RBAC.4; the model·confidence·approver record is
  /// AUDIT.3 — keep this as a plain status here.
  stage      String

  @@index([orgId])
}

model FirmwareRelease {
  id      String @id @default(cuid())
  orgId   String
  org     Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  version String
  note    String
  state   String

  @@index([orgId])
}

model CompatCell {
  id        String @id @default(cuid())
  orgId     String
  org       Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  hwRev     String
  fwVersion String
  state     String // cert/compatible/in-test/na

  @@index([orgId])
  @@index([hwRev, fwVersion])
}

/// Autonomy telemetry (autonomy-rate / takeovers per site) feeding operational
/// memory (MEM.1). Plain table for the prototype.
model AutonomyMetric {
  id             String   @id @default(cuid())
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site           String
  ts             DateTime
  autonomyRate   Float
  takeoversPer1k Float
  policyVersion  String

  @@index([orgId])
  @@index([site, ts])
}

model SafetyIncident {
  id          String   @id @default(cuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  code        String
  type        String
  robotSerial String
  site        String
  severity    Severity
  status      String

  @@index([orgId])
}

model PolicyVersion {
  id      String @id @default(cuid())
  orgId   String
