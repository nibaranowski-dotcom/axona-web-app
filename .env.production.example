# ─────────────────────────────────────────────────────────────────────────────
# Axona — PRODUCTION environment (GOLIVE.2a)
#
# NAMES + SOURCES ONLY. This file carries NO real values and is committed as a
# reference. Set every value in the Railway dashboard (Service → Variables) — never
# in the repo, never in chat. Set the same shared vars on BOTH the WEB and WORKER
# services (or in a shared Railway "variable group"); web-only vars are noted.
#
# Railway plugin references (recommended) let you wire DB/Redis without copying URLs:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
#   REDIS_URL    = ${{Redis.REDIS_URL}}
# ─────────────────────────────────────────────────────────────────────────────

# ── Data stores (Railway plugins) — WEB + WORKER ─────────────────────────────
# Railway Postgres plugin. Prisma connects here; `prisma migrate deploy` runs against it.
DATABASE_URL=
# Railway Redis plugin. BullMQ queues (worker + the web enqueue path).
REDIS_URL=

# ── Blob store: Cloudflare R2 (S3-compatible) — WEB + WORKER ──────────────────
# R2 S3 API endpoint:  https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# R2 API token → "Access Key ID".
S3_ACCESS_KEY=
# R2 API token → "Secret Access Key".
S3_SECRET_KEY=
# The R2 bucket name you create (e.g. axona-files).
S3_BUCKET=
# R2 ignores region; use "auto". (Defaults to us-east-1 if unset — R2 tolerates it.)
S3_REGION=

# ── Auth + app URL (Auth.js v5) — WEB ────────────────────────────────────────
# Session/signing secret. Generate once:  openssl rand -base64 32
AUTH_SECRET=
# The public app origin — Auth.js callback base. Same value as APP_URL (e.g. the
# proposed https://app.axonahq.com). Set once the domain is bound.
AUTH_URL=
# The public app URL used for invite / SAML ACS / token links (e.g. https://app.axonahq.com).
APP_URL=

# ── Anthropic (the agent runtime) — WEB + WORKER ─────────────────────────────
# From the Anthropic console (console.anthropic.com → API keys).
ANTHROPIC_API_KEY=
# The model id the runtime uses (e.g. a current Claude model id).
ANTHROPIC_MODEL=
# Optional — max output tokens per call (has a sensible default; leave blank to use it).
ANTHROPIC_MAX_TOKENS=

# ── Transactional email: Resend — WEB ────────────────────────────────────────
# From the Resend dashboard (resend.com → API Keys).
RESEND_API_KEY=
# Verified sender identity (e.g. "Axona <noreply@axonahq.com>") — must be a Resend-verified domain.
EMAIL_FROM=

# ── Embeddings (semantic search + MEM.1) — WEB + WORKER · OPTIONAL/RECOMMENDED ─
# Without EMBED_API_KEY the app falls back to a deterministic FakeEmbedder (works, but
# NOT semantically meaningful). Set these for real semantic search in production.
EMBED_API_KEY=
# Optional — the embeddings API base URL (defaults to the built-in provider if unset).
EMBED_BASE_URL=
# Optional — the embeddings model id (defaults if unset).
EMBED_MODEL=

# NODE_ENV is set to "production" by the Docker images — do not override.
